# Server-only. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-supabase-host
SUPABASE_SECRET_KEY=
# HTTPS application base URL. Deploy its /from-calculator receiver first.
NEXT_PUBLIC_KPR_APPLICATION_URL=https://ruangkpr-node-js.vercel.app
# Set only on the deployment mounted at remax.co.id/maxloan. Leave unset
# for local dev and for this app's own standalone Vercel domain.
NEXT_PUBLIC_BASE_PATH=/maxloan
